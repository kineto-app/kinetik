# Pass environment variables to npm start. No secrets are needed by the mock model.
KINETIK_BIND=127.0.0.1
KINETIK_PORT=4173
KINETIK_OPEN_BROWSER=1
# Keep the static server running for development or a self-hosted deployment.
# By default it closes once the PWA confirms its offline cache is ready.
KINETIK_KEEP_ALIVE=0
